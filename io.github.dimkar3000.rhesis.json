{
	"id": "io.github.dimkar3000.rhesis",
	"runtime": "org.kde.Platform",
	"runtime-version": "6.11",
	"sdk": "org.kde.Sdk",
	"command": "rhesis",
	"desktop-file-name-suffix": "",
	"finish-args": [
		"--share=ipc",
		"--share=network",
		"--device=dri",
		"--socket=fallback-x11",
		"--socket=wayland"
	],
	"modules": [
		{
			"name": "rhesis",
			"buildsystem": "simple",
			"build-commands": [
				"install -Dm755 bin/rhesis /app/bin/rhesis",
				"install -Dm755 fasttext-source/fasttext /app/bin/fasttext",
				"install -Dm644 lid.176.ftz /app/share/rhesis/lid.176.ftz",
				"mkdir -p /app/lib /app/share/rhesis",
				"cp -r languagetool-source /app/share/rhesis/LanguageTool",
				"printf 'fasttextModel=../../../share/rhesis/lid.176.ftz\\nfasttextBinary=../../../bin/fasttext\\n' > /app/share/rhesis/LanguageTool/server.properties",
				"cp -r share/* /app/share/",
				"cp -r java-source/jre /app/lib/",
				"ln -s ../lib/jre/bin/java /app/bin/java"
			],
			"sources": [
				{
					"type": "dir",
					"path": "build/artifacts/app"
				},
				{
					"type": "dir",
					"path": "build/artifacts/fastText",
					"dest": "fasttext-source"
				},
				{
					"type": "file",
					"path": "build/artifacts/lid.176.ftz"
				},
				{
					"type": "dir",
					"path": "build/artifacts/LanguageTool",
					"dest": "languagetool-source"
				},
				{
					"type": "dir",
					"path": "build/artifacts/java",
					"dest": "java-source"
				}
			]
		}
	]
}
